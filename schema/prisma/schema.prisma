// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id String @id
  title String
  description String
  thumbnailUrl String @map(name: "thumbnail_url")

  videos Video[]

  @@map("channels")
}

model Video {
  id String @id
  channelId String @map(name: "channel_id")
  channel Channel @relation(fields: [channelId], references: [id])
  title String
  description String
  thumbnailUrl String @map(name: "thumbnail_url")
  startsAt DateTime @map(name: "starts_at")

  @@map("videos")
}
